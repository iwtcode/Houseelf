<?xml version="1.0" encoding="utf-8"?>
<!-- Статические ярлыки на иконке приложения: зажать иконку → «Домовой.Чат» или «Домовой.Событие» -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="chat_from_clipboard"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/chat_label"
        android:shortcutLongLabel="@string/chat_shortcut_long">
        <intent
            android:action="com.example.houseelf.action.CAPTURE_CLIPBOARD"
            android:targetClass="com.example.houseelf.capture.CaptureActivity"
            android:targetPackage="com.example.houseelf" />
    </shortcut>
    <shortcut
        android:shortcutId="event_from_clipboard"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/event_label"
        android:shortcutLongLabel="@string/event_shortcut_long">
        <intent
            android:action="com.example.houseelf.action.EVENT_FROM_CLIPBOARD"
            android:targetClass="com.example.houseelf.event.EventCaptureActivity"
            android:targetPackage="com.example.houseelf" />
    </shortcut>
</shortcuts>
